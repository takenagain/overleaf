# The source image is built from this checkout by the GHCR workflow.
ARG OVERLEAF_SOURCE_IMAGE
FROM ${OVERLEAF_SOURCE_IMAGE}

ARG TEXLIVE_MIRROR=https://mirror.ox.ac.uk/sites/ctan.org/systems/texlive/tlnet

# The native base build already installs TeX Live 2026 with signature verification.
RUN set -eux; \
    tlmgr option repository "${TEXLIVE_MIRROR}"; \
    tlmgr update --self --all; \
    tlmgr install collection-latexextra algorithm2e; \
    tlmgr path add; \
    if command -v luaotfload-tool >/dev/null 2>&1; then luaotfload-tool -fu; fi; \
    rm -rf /usr/local/texlive/2026/tlpkg/backups
