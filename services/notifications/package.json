{
  "name": "@overleaf/notifications",
  "description": "An API to handle user notifications",
  "private": true,
  "main": "app.ts",
  "type": "module",
  "scripts": {
    "start": "node app.ts",
    "test:acceptance:_run": "vitest --config ./vitest.config.acceptance.cjs",
    "test:acceptance": "yarn run test:acceptance:_run",
    "test:unit:_run": "vitest --config ./vitest.config.unit.cjs",
    "test:unit": "yarn run test:unit:_run",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix .",
    "types:check": "node ../../tools/type-check.mjs --noEmit",
    "nodemon": "node --watch app.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@overleaf/fetch-utils": "workspace:*",
    "@overleaf/logger": "workspace:*",
    "@overleaf/metrics": "workspace:*",
    "@overleaf/mongo-utils": "workspace:*",
    "@overleaf/o-error": "workspace:*",
    "@overleaf/promise-utils": "workspace:*",
    "@overleaf/settings": "workspace:*",
    "@overleaf/validation-tools": "workspace:*",
    "async": "^3.2.6",
    "bunyan": "^1.8.15",
    "express": "5.3.0",
    "mongodb": "7.7.0",
    "mongodb-legacy": "6.1.3",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@overleaf/migrations": "workspace:*",
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.0.5"
  }
}
