{
  "name": "@overleaf/real-time",
  "description": "The socket.io layer of Overleaf for real-time editor interactions",
  "private": true,
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "test:acceptance:_run": "mocha --recursive --timeout 15000 --exit --retries=$RETRIES $@ test/acceptance/js",
    "test:acceptance": "yarn run test:acceptance:_run -- --grep=$TEST_NAME_PATTERN",
    "test:unit:_run": "vitest --config ./vitest.config.unit.cjs",
    "test:unit": "yarn run test:unit:_run",
    "nodemon": "node --watch app.js",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix .",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "dependencies": {
    "@overleaf/fetch-utils": "workspace:*",
    "@overleaf/logger": "workspace:*",
    "@overleaf/metrics": "workspace:*",
    "@overleaf/o-error": "workspace:*",
    "@overleaf/promise-utils": "workspace:*",
    "@overleaf/redis-wrapper": "workspace:*",
    "@overleaf/settings": "workspace:*",
    "@overleaf/validation-tools": "workspace:*",
    "async": "^3.2.6",
    "base64id": "2.0.0",
    "bunyan": "^1.8.15",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "5.3.0",
    "express-session": "^1.19.0",
    "lodash": "^4.18.1",
    "overleaf-editor-core": "workspace:*",
    "proxy-addr": "^2.0.8",
    "socket.io": "github:overleaf/socket.io#0.9.19-overleaf-12",
    "socket.io-client": "https://github.com/overleaf/socket.io-client/archive/refs/tags/0.9.17-overleaf-6.tar.gz",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "cookie-signature": "^1.2.2",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "sinon": "^22.1.0",
    "sinon-chai": "4.0.1",
    "timekeeper": "2.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "uid-safe": "^2.1.5",
    "vitest": "5.0.5",
    "ws": "^8.22.0"
  }
}
