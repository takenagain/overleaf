{
  "name": "@overleaf/chat",
  "description": "The backend API that powers Overleaf chat",
  "private": true,
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "test:acceptance": "yarn run test:acceptance:_run -- --grep=$TEST_NAME_PATTERN",
    "test:unit": "yarn run test:unit:_run -- --grep=$TEST_NAME_PATTERN",
    "nodemon": "node --watch app.js",
    "test:acceptance:_run": "mocha --recursive --timeout 15000 --exit --retries=$RETRIES $@ test/acceptance/js",
    "test:unit:_run": "mocha --recursive --exit $@ test/unit/js",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix .",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "dependencies": {
    "@overleaf/logger": "*",
    "@overleaf/metrics": "*",
    "@overleaf/mongo-utils": "*",
    "@overleaf/promise-utils": "*",
    "@overleaf/settings": "*",
    "@overleaf/validation-tools": "workspace:*",
    "async": "^3.2.6",
    "express": "5.3.0",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@overleaf/migrations": "workspace:*",
    "@types/node": "^26.6.5",
    "acorn": "^8.19.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "request": "npm:postman-request@2.88.1-postman.51",
    "sinon": "^22.1.0",
    "timekeeper": "^2.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "version": "1.0.0",
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0"
}
