{
  "name": "@overleaf/project-history",
  "description": "An API for saving and compressing individual document updates into a browseable history",
  "private": true,
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test:acceptance": "yarn run test:acceptance:_run -- --grep=$TEST_NAME_PATTERN",
    "test:unit": "yarn run test:unit:_run -- --grep=$TEST_NAME_PATTERN",
    "start": "node app.js",
    "nodemon": "node --watch app.js",
    "test:acceptance:_run": "mocha --loader=esmock --recursive --timeout 15000 --exit --retries=$RETRIES $@ test/acceptance/js",
    "test:unit:_run": "mocha --loader=esmock --recursive --exit $@ test/unit/js",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix .",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "dependencies": {
    "@overleaf/fetch-utils": "workspace:*",
    "@overleaf/logger": "workspace:*",
    "@overleaf/metrics": "workspace:*",
    "@overleaf/mongo-utils": "workspace:*",
    "@overleaf/o-error": "workspace:*",
    "@overleaf/promise-utils": "workspace:*",
    "@overleaf/redis-wrapper": "workspace:*",
    "@overleaf/settings": "workspace:*",
    "@overleaf/stream-utils": "workspace:*",
    "@overleaf/validation-tools": "workspace:*",
    "async": "^3.2.6",
    "bunyan": "^1.8.15",
    "diff-match-patch": "overleaf/diff-match-patch#89805f9c671a77a263fc53461acd62aa7498f688",
    "express": "5.3.0",
    "lodash": "^4.18.1",
    "minimist": "^1.2.8",
    "mongodb": "7.7.0",
    "mongodb-legacy": "6.1.3",
    "overleaf-editor-core": "workspace:*",
    "p-queue": "^10.0.0"
  },
  "devDependencies": {
    "@overleaf/migrations": "workspace:*",
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.13.0",
    "esmock": "patch:esmock@npm%3A2.7.3#~/.yarn/patches/esmock-npm-2.7.3-83624b28f6.patch",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "mongodb": "7.7.0",
    "nock": "^15.0.5",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "timekeeper": "2.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
