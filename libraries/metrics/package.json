{
  "name": "@overleaf/metrics",
  "version": "4.2.0",
  "description": "A drop-in metrics and monitoring module for node.js apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/overleaf/metrics-module.git"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.1.0",
    "@google-cloud/profiler": "^8.2.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "compression": "^1.8.2",
    "prom-client": "^15.1.3",
    "yn": "^5.1.0"
  },
  "devDependencies": {
    "@overleaf/logger": "workspace:*",
    "@types/node": "^26.6.5",
    "bunyan": "^1.8.15",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "sandboxed-module": "^2.0.4",
    "sinon": "^22.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --ext .cjs,.js,.jsx,.mjs,.ts --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix --ext .cjs,.js,.jsx,.mjs,.ts .",
    "test:unit": "mocha --exit test/**/*.{js,cjs}",
    "test:acceptance": "mocha --recursive --exit --grep=${TEST_NAME_PATTERN:-} test/acceptance",
    "test": "yarn run lint && yarn run types:check && yarn run test:unit",
    "test:ci": "yarn run test:unit",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "peerDependencies": {
    "@overleaf/logger": "workspace:*"
  }
}
