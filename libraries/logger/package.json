{
  "name": "@overleaf/logger",
  "homepage": "www.overleaf.com",
  "description": "A centralised logging system for Overleaf",
  "repository": {
    "type": "git",
    "url": "https://github.com/overleaf/overleaf"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "license": "AGPL-3.0-only",
  "version": "3.1.1",
  "scripts": {
    "test": "yarn run lint && yarn run types:check && yarn run test:unit",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --ext .cjs,.js,.jsx,.mjs,.ts --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix --ext .cjs,.js,.jsx,.mjs,.ts .",
    "test:ci": "yarn run test:unit",
    "test:unit": "mocha --exit test/**/*.{js,cjs}",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "dependencies": {
    "@google-cloud/logging-bunyan": "^6.3.0",
    "@overleaf/fetch-utils": "workspace:*",
    "@overleaf/o-error": "workspace:*",
    "@overleaf/validation-tools": "workspace:*",
    "bunyan": "^1.8.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "sandboxed-module": "^2.0.4",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "@overleaf/metrics": "workspace:*"
  }
}
