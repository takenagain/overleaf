{
  "name": "@overleaf/object-persistor",
  "version": "1.0.2",
  "description": "Module for storing objects in multiple backends, with fallback on 404 to assist migration between them",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "scripts": {
    "test": "yarn run lint && yarn run types:check && yarn run test:unit",
    "test:unit": "mocha --exit test/**/*.{js,cjs}",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --ext .cjs,.js,.jsx,.mjs,.ts --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix --ext .cjs,.js,.jsx,.mjs,.ts .",
    "test:ci": "yarn run test:unit",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "github.com:overleaf/object-persistor"
  },
  "author": "Overleaf (https://www.overleaf.com/)",
  "license": "AGPL-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@aws-sdk/node-http-handler": "^3.374.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@google-cloud/storage": "^8.4.0",
    "@overleaf/logger": "workspace:*",
    "@overleaf/metrics": "workspace:*",
    "@overleaf/o-error": "workspace:*",
    "@overleaf/stream-utils": "workspace:*",
    "fast-crc32c": "overleaf/node-fast-crc32c#aae6b2a4c7a7a159395df9cc6c38dfde702d6f51",
    "glob": "^13.0.6",
    "range-parser": "^1.3.0",
    "tiny-async-pool": "^2.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "mongodb": "7.7.0",
    "sandboxed-module": "^2.0.4",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
