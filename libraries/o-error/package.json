{
  "name": "@overleaf/o-error",
  "version": "3.4.0",
  "description": "Light-weight helpers for handling JavaScript Errors in node.js and the browser. Helps with long stack traces, Error subclasses, wrapping internal errors (causes), and attaching extra data to errors for logging.",
  "keywords": [
    "browser",
    "node",
    "error",
    "long stack trace",
    "stack trace",
    "stack",
    "cause",
    "verror"
  ],
  "main": "index.cjs",
  "files": [
    "index.cjs"
  ],
  "scripts": {
    "build": "yarn run --silent test",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --ext .cjs,.js,.jsx,.mjs,.ts --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix --ext .cjs,.js,.jsx,.mjs,.ts .",
    "test": "yarn run lint && yarn run types:check && yarn run test:unit",
    "test:ci": "yarn run test:unit",
    "test:unit": "mocha --exit test/**/*.{js,cjs}",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "author": "Overleaf (https://www.overleaf.com)",
  "license": "MIT",
  "repository": "github:overleaf/o-error",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
