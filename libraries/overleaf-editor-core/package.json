{
  "name": "overleaf-editor-core",
  "version": "1.0.0",
  "description": "Library shared between the editor server and clients.",
  "main": "index.js",
  "scripts": {
    "test": "yarn run lint && yarn run types:check && yarn run test:unit",
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --ext .cjs,.js,.jsx,.mjs,.ts --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix --ext .cjs,.js,.jsx,.mjs,.ts .",
    "test:ci": "yarn run test:unit",
    "test:unit": "mocha --exit test/**/*.{js,cjs}",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "author": "team@overleaf.com",
  "license": "Proprietary",
  "private": true,
  "devDependencies": {
    "@types/check-types": "^11.2.2",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/path-browserify": "^1.0.3",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "sinon": "^22.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@overleaf/o-error": "workspace:*",
    "@overleaf/validation-tools": "workspace:*",
    "check-types": "^11.2.3",
    "diff-match-patch": "overleaf/diff-match-patch#89805f9c671a77a263fc53461acd62aa7498f688",
    "lodash": "^4.18.1",
    "p-map": "^7.1.1",
    "path-browserify": "^1.0.1",
    "utf-8-validate": "^6.0.6"
  }
}
