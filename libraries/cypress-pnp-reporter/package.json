{
  "name": "@overleaf/cypress-pnp-reporter",
  "description": "cypress-multi-reporters, loadable from Cypress's Electron process, which has no Yarn PnP",
  "main": "index.cjs",
  "files": [
    "index.cjs"
  ],
  "author": "Overleaf (https://www.overleaf.com)",
  "private": true,
  "scripts": {
    "lint": "eslint --cache --cache-location ../../.cache/eslint/ --ext .cjs,.js,.jsx,.mjs,.ts --max-warnings 0 .",
    "lint:fix": "eslint --cache --cache-location ../../.cache/eslint/ --fix --ext .cjs,.js,.jsx,.mjs,.ts .",
    "test": "yarn run lint && yarn run types:check && yarn run test:unit",
    "test:ci": "yarn run test:unit",
    "test:unit": "mocha --exit test/**/*.{js,cjs}",
    "types:check": "node ../../tools/type-check.mjs --noEmit"
  },
  "dependencies": {
    "cypress-multi-reporters": "patch:cypress-multi-reporters@npm%3A2.0.5#~/.yarn/patches/cypress-multi-reporters-npm-2.0.5-70802a4d20.patch"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "patch:mocha-junit-reporter@npm%3A2.2.1#~/.yarn/patches/mocha-junit-reporter-npm-2.2.1-e02a1e67a3.patch",
    "mocha-multi-reporters": "^1.5.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
